# Core Django settings
DEBUG=true
DJANGO_SECRET_KEY=default-insecure-key-for-dev

# Database Configuration
# DATABASE_URL=postgres://user:password@localhost:5432/divine_main

# Clerk Authentication (Leave empty in dev to allow pass-through if not testing auth)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_JWT_ISSUER=https://your-clerk-issuer-url

# Cloudflare R2 / AWS S3 Configuration
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-<random>.r2.dev

# External Services
EMAIL_API_KEY=your_email_api_key

# Postman MCP
POSTMAN_API_KEY=your_postman_api_key
